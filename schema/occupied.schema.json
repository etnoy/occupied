{
  "$defs": {
    "AbsoluteTime": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "required": [
        "start"
      ],
      "title": "AbsoluteTime",
      "type": "object"
    },
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^(?:turn_on|turn_off|[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*)$",
          "title": "Action",
          "type": "string"
        },
        "entities": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "action",
        "entities"
      ],
      "title": "Action",
      "type": "object"
    },
    "Day": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "RandomEvent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "days": {
          "default": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "items": {
            "$ref": "#/$defs/Day"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/Timing"
        },
        "end": {
          "$ref": "#/$defs/Timing"
        },
        "min_duration": {
          "default": "5m",
          "gt": 0,
          "title": "Min Duration",
          "type": "string"
        },
        "max_duration": {
          "default": "15m",
          "gt": 0,
          "title": "Max Duration",
          "type": "string"
        },
        "count": {
          "default": 3,
          "maximum": 1000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "on": {
          "$ref": "#/$defs/Action"
        },
        "off": {
          "$ref": "#/$defs/Action"
        }
      },
      "required": [
        "start",
        "end",
        "on",
        "off"
      ],
      "title": "RandomEvent",
      "type": "object"
    },
    "RelativeTo": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "sun"
                ]
              },
              {
                "required": [
                  "entity"
                ]
              }
            ]
          },
          "properties": {
            "step": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "step"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "step"
                ]
              },
              {
                "required": [
                  "entity"
                ]
              }
            ]
          },
          "properties": {
            "sun": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "sun"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "step"
                ]
              },
              {
                "required": [
                  "sun"
                ]
              }
            ]
          },
          "properties": {
            "entity": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "entity"
          ]
        }
      ],
      "properties": {
        "step": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "sun": {
          "anyOf": [
            {
              "enum": [
                "sunrise",
                "sunset",
                "dawn",
                "dusk",
                "noon",
                "midnight"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sun"
        },
        "entity": {
          "anyOf": [
            {
              "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "attribute": {
          "anyOf": [
            {
              "enum": [
                "start_time",
                "end_time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "start_offset": {
          "default": "0s",
          "title": "Start Offset",
          "type": "string"
        },
        "end_offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        }
      },
      "title": "RelativeTo",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^(?:turn_on|turn_off|[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*)$",
          "title": "Action",
          "type": "string"
        },
        "entities": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "days": {
          "default": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "items": {
            "$ref": "#/$defs/Day"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        }
      },
      "required": [
        "action",
        "entities",
        "timing"
      ],
      "title": "Step",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "relative_to"
                ]
              }
            ]
          },
          "properties": {
            "absolute_time": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "absolute_time"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "absolute_time"
                ]
              }
            ]
          },
          "properties": {
            "relative_to": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "relative_to"
          ]
        }
      ],
      "properties": {
        "absolute_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsoluteTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relative_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeTo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Timing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "steps": {
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "$ref": "#/$defs/Step"
        }
      },
      "title": "Steps",
      "type": "object"
    },
    "random": {
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "$ref": "#/$defs/RandomEvent"
        }
      },
      "title": "Random",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "name"
  ],
  "title": "Program",
  "type": "object"
}
