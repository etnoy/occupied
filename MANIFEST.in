include LICENSE README.md hacs.json uv.lock package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json .prettierignore .prettierrc.json eslint.config.mjs mise.toml
recursive-include docs *.md
recursive-include examples *.yaml
recursive-include media *.svg *.png
recursive-include scripts *.py *.txt *.overrides *.ts *.mjs *.toml *.constraints
recursive-include tests *.py *.ts
recursive-include tests/fixtures *.yaml *.md
recursive-include .github/workflows *.yml
recursive-include schema *.json
recursive-include custom_components/occupied *.json *.yaml *.js *.ts *.svelte *.css *.png
include custom_components/occupied/frontend/README.md .github/dependabot.yml
global-exclude __pycache__ *.py[cod] .DS_Store
