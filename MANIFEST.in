include LICENSE README.md hacs.json uv.lock package.json package-lock.json tsconfig.json .prettierignore eslint.config.mjs
recursive-include docs *.md
recursive-include examples *.yaml *.pp
recursive-include media *.svg
recursive-include scripts *.py *.txt *.overrides *.ts
recursive-include tests *.py *.ts *.html
recursive-include .github/workflows *.yml
recursive-include schema *.json
recursive-include custom_components/occupied *.json *.yaml *.js *.ts *.png
global-exclude __pycache__ *.py[cod] .DS_Store
