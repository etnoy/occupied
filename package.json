{
  "name": "occupied-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build-frontend.ts",
    "build:check": "node scripts/build-frontend.ts --check",
    "lint": "eslint \"custom_components/occupied/frontend/src/**/*.{ts,svelte}\" \"tests/frontend/**/*.ts\" \"tests/browser/**/*.ts\" \"scripts/*.{ts,mjs}\" --max-warnings 0",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm run build:tests && node --test tests/frontend/generated/*.test.js",
    "format:check": "prettier --check custom_components/occupied/frontend tests/frontend tests/browser \"scripts/*.{ts,mjs}\" eslint.config.mjs tsconfig.json package.json .prettierrc.json .github/workflows .github/dependabot.yml",
    "format:fix": "prettier --write \"custom_components/occupied/frontend/src/**/*.{ts,svelte,css}\" \"tests/frontend/src/*.ts\" tests/browser \"scripts/*.{ts,mjs}\" eslint.config.mjs tsconfig.json package.json .prettierrc.json .github/workflows && pnpm run build",
    "build:tests": "node scripts/build-frontend.ts --tests-only",
    "lint:fix": "eslint \"custom_components/occupied/frontend/src/**/*.{ts,svelte}\" \"tests/frontend/**/*.ts\" \"tests/browser/**/*.ts\" \"scripts/*.{ts,mjs}\" --fix --max-warnings 0 && pnpm run build",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.11.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "svelte": "5.57.2"
  }
}
