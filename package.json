{
  "name": "occupied-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build-frontend.ts",
    "build:check": "node scripts/build-frontend.ts --check",
    "lint": "eslint \"custom_components/occupied/frontend/dist/**/*.js\" --max-warnings 0",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm run build:tests && node --test tests/frontend/generated/model.test.js",
    "format:check": "prettier --check custom_components/occupied/frontend tests/frontend scripts/*.ts eslint.config.mjs tsconfig.json package.json .prettierrc.json .github/workflows",
    "format:fix": "prettier --write \"custom_components/occupied/frontend/*.{ts,svelte}\" \"tests/frontend/src/*.ts\" scripts/*.ts eslint.config.mjs tsconfig.json package.json .prettierrc.json .github/workflows && pnpm run build",
    "build:tests": "node scripts/build-frontend.ts --tests-only"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "svelte": "5.57.2"
  }
}
